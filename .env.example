OPENROUTER_API_KEY=
OPENROUTER_APP_TITLE=ff-analytics-agent
OPENROUTER_APP_URL=https://github.com/<you>/ff-analytics-agent
CUBE_URL=https://<deployment>.<region>.cubecloudapp.dev     # base only; client appends /cubejs-api/v1
CUBEJS_API_SECRET=                                          # must equal CUBEJS_API_SECRET in Cube Cloud → Settings → Environment variables
CLICKHOUSE_HOST=                                            # used ONLY by warehouse/seed.py — xxxx.<region>.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
AGENT_AS_OF_DATE=2026-09-14
