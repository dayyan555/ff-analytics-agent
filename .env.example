# Copy to .env and fill in the values. Comments must stay on their own lines
# (python-dotenv would otherwise read an inline comment as the value).

# --- OpenRouter (free router; enable the two free-endpoint privacy toggles in Settings > Privacy)
OPENROUTER_API_KEY=
OPENROUTER_APP_TITLE=ff-analytics-agent
OPENROUTER_APP_URL=https://github.com/<you>/ff-analytics-agent

# --- Cube Cloud
# Base URL only (the client appends /cubejs-api/v1), e.g. https://<deployment>.<region>.cubecloudapp.dev
CUBE_URL=
# Must equal CUBEJS_API_SECRET in Cube Cloud > Settings > Environment variables (openssl rand -hex 32)
CUBEJS_API_SECRET=

# --- ClickHouse Cloud (read only by warehouse/seed.py; the agent never connects to ClickHouse)
# Host without scheme, e.g. xxxx.<region>.gcp.clickhouse.cloud
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true

# --- Langfuse Cloud (optional: without keys the app runs with tracing disabled)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true

# --- Agent: the pinned "today" that relative periods (last_month, last_N_months) resolve against
AGENT_AS_OF_DATE=2026-09-14
